DE_annotated<-read.csv("Ultimate_MS_table.csv")

library(ggplot2)

DE_annotated$threshold <- as.factor(
  abs(DE_annotated$logFC) > 0.58 & DE_annotated$P.Value < 0.05
)


library(ggrepel)

DE_annotated$regulation <- ifelse(
  DE_annotated$logFC > 0.58, "Up",
  ifelse(DE_annotated$logFC < -0.58, "Down", "NS")
)

library(ggplot2)
library(ggrepel)

ggplot(DE_annotated, aes(x = logFC, y = -log10(P.Value))) +
  
  geom_point(aes(color = regulation), alpha = 0.7) +
  
  scale_color_manual(values = c(
    "Up" = "#F8766D",
    "Down" = "#00BFC4",
    "NS" = "grey"
  )) +
  
  geom_text_repel(
    data = subset(DE_annotated, threshold == "TRUE"),
    aes(label = hgnc_symbol),
    size = 3,
    max.overlaps = 15
  )  +
  
  theme_minimal(base_family = "Arial") +
  
  theme(
    legend.position = "none",
    text = element_text(family = "Arial")
  ) +
  
  labs(
    x = "log2 Fold Change",
    y = "-log10 P-value"
  )

