DE_annotated <- DE_annotated %>%
  left_join(modules, by = "hgnc_symbol")

DE_annotated$Module <- factor(DE_annotated$Module)

DE_annotated <- DE_annotated %>%
  mutate(
    sig = ifelse(P.Value < 0.05 & abs(logFC) > 1, "YES", "NO")
  )

library(ggrepel)
library(ggplot2)

volcano_cols <- c(
  "#1F77B4",  # blue
  "#FF7F0E",  # orange
  "#2CA02C",  # green
  "#D62728",  # red
  "#9467BD",  # purple (strong, visible)
  "#8C564B",  # brown
  "#E377C2",  # pink
  "#17BECF",  # cyan
  "#7A750B",  # olive yellow
  "#FB9A99"   # grey (neutral fallback)
)


ggplot(DE_annotated, aes(x = logFC, y = -log10(P.Value))) +
  
  # all points grey
  geom_point(color = "grey70", alpha = 0.6) +
  geom_point(
    data = subset(DE_annotated, sig == "YES" & !is.na(Module)),
    aes(color = Module),
    size = 2
  )+
  
  # significance threshold lines
  geom_vline(xintercept = c(-1, 1), linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
  
  # labeled genes only
  geom_text_repel(
    data = subset(DE_annotated, sig == "YES" & !is.na(Module)),
    aes(label = hgnc_symbol, color = Module),
    size = 3,
    max.overlaps = 20,
    show.legend = FALSE
  ) +
  
  scale_color_manual(values = volcano_cols) +
  
  theme_minimal(base_family = "Arial") +
  
  theme(
    legend.position = "right",
    text = element_text(family = "Arial")
  ) +
  
  labs(
    x = "log2 Fold Change",
    y = "-log10 P-value",
    title = "Volcano plot (MS differential expression)"
  )
