# ===============================
# 3. Main patient processing function
# ===============================
process_patient <- function(CosMX, patient_id, radius = 0.05, k = 50, top_n = 20) {
  message("Processing patient: ", patient_id)
  
  seurat_object <- subset_opt(CosMX, fov == patient_id)
  annot <- seurat_object@meta.data
  norm <- t(as.matrix(seurat_object@assays$Nanostring$counts))
  xy <- GetTissueCoordinates(seurat_object) %>%
    mutate(x = x - min(x), y = y - min(y)) %>%
    select(x, y)
  rownames(xy) <- Cells(seurat_object)
  
  # Spatial graph
  neighbors <- InSituCor:::radiusBasedGraph(x = xy$x, y = xy$y, R = radius, subset = 1)
  
  # Spatial correlation
  step1 <- calcSpatialCor(
    counts = norm, conditionon = annot[, c("nCount_Nanostring", "manualannot")],
    neighbors = NULL, xy = xy, k = k, roundcortozero = 0.1, max_cells = 10000
  )
  
  # All celltype pairs
  celltypes <- unique(as.character(seurat_object$manualannot))
  feat_pairs <- expand.grid(A = celltypes, B = celltypes)
  feat_pairs <- feat_pairs %>%
    filter(!(A %in% c("basal_squamous", "mature_squamous") & grepl("Cluster", A))) %>%
    filter(!B %in% c("basal_squamous", "mature_squamous"))
  
  results <- lapply(seq_len(nrow(feat_pairs)), function(i) {
    a <- feat_pairs$A[i]; b <- feat_pairs$B[i]
    a_names <- rownames(annot[annot$manualannot == a, ])
    b_names <- rownames(annot[annot$manualannot == b, ])
    
    if (length(a_names) == 0 || length(b_names) == 0) {
      return(data.frame(a = a, b = b, c = 0, patient = patient_id))
    }
    f <- reshape2::melt(as.matrix(step1$neighbors[a_names, b_names, drop = FALSE]))
    colnames(f) <- c("cellA", "cellB", "correlation")
    f$a <- a
    f$b <- b
    # f <- f[f$correlation > 0, ]
    top_k <- top_N_column_names_new(step1$neighbors[a_names, , drop = FALSE], top_n)
    if (length(top_k) == 0) {
      m <- 0
    } else {
      #result <- report_column_names(top_10, b_names)
      per_cell_counts <- count_neighbors(top_k, b_names)
      print(class(per_cell_counts))
      #top_k sometimes returns fewer elements (e.g., due to filtering or sparse data)
      #In that case, you’d be dividing by 20 even if a cell only had, say, 12 neighbors → biases your result
      #m <- mean(per_cell_counts / lengths(top_k), na.rm = TRUE)
      #per_cell_counts<-per_cell_counts[per_cell_counts>0]
      #m <- mean(per_cell_counts)
      # define B/plasma cells
      selected_cells<-paste("Cluster",unique(seurat_object2$type),sep="")
      selected_cells<-c(selected_cells,"macrophages")
      selected_cells<- selected_cells[!selected_cells %in% c("M1like")]
      bp_cells <- rownames(annot[annot$manualannot %in% selected_cells, ])
      
      # denominator: count only B/plasma neighbors per cell
      bp_neighbor_counts <- sapply(top_k, function(neigh) {
        sum(neigh %in% bp_cells)
      })
      
      # avoid division by zero
      valid <- bp_neighbor_counts > 0
      
      m <- mean(per_cell_counts[valid] / bp_neighbor_counts[valid], na.rm = TRUE)
      
    }
    
    # if (nrow(f) == 0) {
    #   return(data.frame(a = a, b = b, c = NA, patient = patient_id))
    # }
    # 
    
    data.frame(a = a, b = b, c = m, patient = patient_id)
  })
  
  do.call(rbind, results)
}

