data <- as.integer(as.matrix(gene_sample_matrix))

# Convert to integer matrix
integer_matrix <- apply(gene_sample_matrix, c(1, 2), as.integer)

# Maintain row and column names
rownames(integer_matrix) <- rownames(gene_sample_matrix)
colnames(integer_matrix) <- colnames(gene_sample_matrix)

data<-integer_matrix
normalized_matrix <- function(data, df) {
  
  # CPM normalization
  cpm_matrix <- cpm(data)
  
  list(
    CPM = cpm_matrix,
    Raw = data
  )
}

normalized_matrices <- normalized_matrix(gene_sample_matrix,df)

library(edgeR)
metadata <- data.frame(
  sampleID  = df$library_name,
  condition = factor(df$response),
  batch     = factor(df$title))
rownames(metadata) <- metadata$sampleID
library(metaRNASeq)
library(SurfR)
df.OSR <- DGE(expression = round(normalized_matrices[["CPM"]]),
              metadata = metadata,
              Nreplica = min(table(metadata$condition)),
              design = "~condition",
              condition = "condition",
              alpha = 0.05,
              TEST = "CR", CTRL =  "NR",
