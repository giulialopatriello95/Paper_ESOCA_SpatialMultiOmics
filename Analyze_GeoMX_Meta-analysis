  "COLLAPSED_METADATA.csv",sep=";"
)

gene_sample_matrix<-as.data.frame(gene_sample_matrix)
rownames(gene_sample_matrix)<-gene_sample_matrix$Gene
gene_sample_matrix<-gene_sample_matrix[,df$library_name]

# IMPORTANT: this file's column is lowercase "batch", not "Batch".
# Using df$Batch (capital) here silently returns 0/0 since the column
# doesn't exist — that was the bug flagged earlier in Meta.R.
Replica.FREGAT <- sum(df$batch == "FREGAT", na.rm = TRUE)
Replica.OSR    <- sum(df$batch == "OSR",    na.rm = TRUE)

