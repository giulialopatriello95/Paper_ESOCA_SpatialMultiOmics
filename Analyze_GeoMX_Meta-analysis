df2<-read.table("FinalSignature_STROMA.txt",sep="\t",header=T)

df2_expanded <- df2 %>%
  separate_rows(GeneInvolved, sep = "/") 
colnames(df2_expanded)<-c("Pathway","GeneID")

metacomb_stroma<-metacomb_stroma[metacomb_stroma$signFC!="0",]
# Step 2: Join with df1
merged_df <- df2_expanded %>%
  inner_join(metacomb_stroma, by = "GeneID")

merged_df1 <- merged_df %>%
  pivot_longer(
    cols = c(FREGAT_log2FC, OSR_log2FC),
    names_to = "Cohort",
    names_pattern = "(.*)_log2FC",
    values_to = "log2FC"
  )


merged_df1$Area<-"Stroma"
all_merged<-merged_df1

all_merged$Pathway <- factor(
  all_merged$Pathway,
  levels = c("Epithelial Mesenchimal transition","Tissue Invasiveness and Plasticity",
             "GPCR Signaling-Chemokine Signaling"              
  )
)

all_merged$Enriched<-"NR"
all_merged$Enriched[all_merged$Pathway %in% 
                      c("GPCR Signaling-Chemokine Signaling")]<-"CR"




all_merged$log2FC_z <- scale(all_merged$log2FC)
all_merged$log2FC_z[all_merged$log2FC>1]<-1
all_merged$log2FC_z[all_merged$log2FC< -1]<- -1
merged_stroma<-all_merged
merged_stroma$Cohort<-factor(merged_stroma$Cohort,levels=c("FREGAT","OSR"))
p_stroma <- ggplot(merged_stroma, aes(x = GeneID, y = Cohort, fill = log2FC_z)) +
  
  geom_tile(color = "white") +
  
  facet_grid(
    . ~ Pathway,
    scales = "free_x",
    space = "free_x",
    labeller = labeller(Pathway = function(x) str_wrap(x, width = 15))
  ) +
  
  scale_fill_gradient2(
    low = "dodgerblue",
    mid = "white",
    high = "red",
    midpoint = 0,
    na.value = "grey90"
  ) +
  
  theme_minimal(base_family = "Arial") +
  
  theme(
    text = element_text(family = "Arial", color = "black"),
    
    axis.text.x = element_text(angle = 90, hjust = 1, size = 12, family = "Arial", color = "black"),
    axis.text.y = element_text(size = 14, family = "Arial", color = "black"),
    
    axis.title.x = element_text(family = "Arial", color = "black"),
    axis.title.y = element_text(family = "Arial", color = "black"),
    
    strip.text.x = element_text(size = 13, family = "Arial", color = "black"),
    strip.text.y = element_text(size = 18, family = "Arial", color = "black"),
    
    plot.title = element_text(family = "Arial", color = "black"),
    
    panel.spacing = unit(0.5, "lines")
  ) +
  
  labs(
    title = "Stromal areas",
    x = "Gene",
    y = "",
    fill = "Zscore"
  )

