
nano.obj2 <-readRDS("Final_Slide2.rds")
nano.obj3 <- readRDS("Final_Slide3.rds")
nano.obj1 <- readRDS("Final_Slide1.rds")

nano.obj2 <- UpdateSeuratObject(nano.obj2)
nano.obj3 <- UpdateSeuratObject(nano.obj3)
nano.obj1 <- UpdateSeuratObject(nano.obj4)

##############################3 MERGE
nano.obj.merge <- merge(nano.obj2, y = c(nano.obj3, nano.obj1), add.cell.ids = c("Slide2", "Slide3", "Slide1"))



# --- Metadata preparation ---
nano.obj.merge$micro <- "otherniches"
nano.obj.merge$micro[nano.obj.merge$niches %in% c("2","3","7")] <- "eipthelia"
nano.obj.merge <- subset(nano.obj.merge, micro != "epithelia")
#nano.obj.merge$manualannot <- paste(nano.obj.merge$micro, nano.obj.merge$manualannot, sep = "_")
DefaultAssay(nano.obj.merge) <- "SCT"

seurat_object2<-subset(nano.obj.merge,subset==CELLTYPE)

seurat_object2$fov<-paste(seurat_object2$patient,seurat_object2$Fov)
pt <- table(seurat_object2$subtype,seurat_object2$fov)
pt <- as.data.frame(pt)



pt<-pt %>%
  group_by(Var2) %>%
  mutate(percent = 100*(Freq/sum(Freq)))
pt$percent<-round(pt$percent,digits = 0)

pt$condition<-"NR"
pt$condition[grepl('ESOCA43',pt$Var2)]<-'CR'
pt$condition[grepl('ESOCA54',pt$Var2)]<-'CR'
pt$condition[grepl('ESOCA45',pt$Var2)]<-'CR'



ggbarplot(pt, x = "Var1", y = "percent", 
          add = c("mean_se", "jitter"),
          color = "condition",
          position = position_dodge(0.8))+xlab("Cluster")+ylab("% Total cells")+ 
  theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
  stat_compare_means(aes(group = condition), method = "t.test",label = "p.signif")

