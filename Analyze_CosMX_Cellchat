nano.obj2 <-readRDS("Final_Slide2.rds")
nano.obj3 <- readRDS("Final_Slide3.rds")
nano.obj1 <- readRDS("Final_Slide1.rds")

nano.obj2 <- UpdateSeuratObject(nano.obj2)
nano.obj3 <- UpdateSeuratObject(nano.obj3)
nano.obj1 <- UpdateSeuratObject(nano.obj4)

##############################3 MERGE
nano.obj.merge <- merge(nano.obj2, y = c(nano.obj3, nano.obj1), add.cell.ids = c("Slide2", "Slide3", "Slide1"))



# --- Metadata preparation ---
nano.obj.merge$micro <- "otherniches"
nano.obj.merge$micro[nano.obj.merge$niches %in% c("2","3","7")] <- "eipthelia"
nano.obj.merge <- subset(nano.obj.merge, micro != "epithelia")
#nano.obj.merge$manualannot <- paste(nano.obj.merge$micro, nano.obj.merge$manualannot, sep = "_")
DefaultAssay(nano.obj.merge) <- "SCT"

nano.obj.merge$micro[nano.obj.merge$niches %in% c("11","12","9","6","10","4","1")]<-"nichetumor"
nano.obj.merge$micro[nano.obj.merge$niches %in% c("5","13","8","10")]<-"nichestromal"



nano.obj.merge$manualannot <- paste(nano.obj.merge$micro, nano.obj.merge$manualannot, sep = "_")


# Select one patient (example)
seurat_object <- subset_opt(nano.obj.merge, patient == "52010783")

# --- Create CellChat object (non-spatial mode) ---
cellchat <- createCellChat(
  object = seurat_object,
  meta = seurat_object@meta.data,
  group.by = "manualannot",
  datatype = "RNA"   # 🔹 non-spatial mode
)

cellchat@meta$manualannot<-as.factor(cellchat@meta$manualannot)
cellchat@meta$manualannot = droplevels(cellchat@meta$manualannot, exclude = setdiff(levels(cellchat@meta$manualannot),unique(cellchat@meta$manualannot)))
# --- Update and set database ---
cellchat <- setIdent(cellchat, ident.use = "manualannot")
cellchat <- updateCellChat(cellchat)
CellChatDB <- CellChatDB.human
cellchat@DB <- CellChatDB
cellchat <- subsetData(cellchat)

# --- Parallelization ---
future::plan("multisession", workers = 4)

# --- Relaxed thresholds for expression detection ---
cellchat <- identifyOverExpressedGenes(cellchat, thresh.pc = 0.05, thresh.fc = 0.05)
cellchat <- identifyOverExpressedInteractions(cellchat)

# --- Compute probabilities (non-spatial) ---
cellchat <- computeCommunProb(cellchat, type = "truncatedMean", trim = 0.05)
cellchat <- filterCommunication(cellchat, min.cells = 10)  # allow smaller populations

# --- Compute pathway probabilities ---
cellchat <- computeCommunProbPathway(cellchat)
cellchat <- aggregateNet(cellchat)

# --- Save output ---
cellchat_52010783 <- cellchat



