# Patients to analyse
patients <- c(
  "ESOCA8",
  "ESOCA43",
  "ESOCA35",
  "ESOCA54",
  "ESOCA55",
  "ESOCA45"
)

# Optional: set parallelization only once
future::plan("multisession", workers = 4)

# Store CellChat objects here
cellchat_list <- list()

for (patient_id in patients) {
  
  message("Processing patient: ", patient_id)
  
  # Select patient
  seurat_object <- subset_opt(
    nano.obj.merge,
    patient == patient_id
  )
  
  # Create CellChat object
  cellchat <- createCellChat(
    object = seurat_object,
    meta = seurat_object@meta.data,
    group.by = "manualannot",
    datatype = "RNA"
  )
  
  # Clean factor levels
  cellchat@meta$manualannot <- as.factor(
    cellchat@meta$manualannot
  )
  
  cellchat@meta$manualannot <- droplevels(
    cellchat@meta$manualannot
  )
  
  # Set identities and database
  cellchat <- setIdent(
    cellchat,
    ident.use = "manualannot"
  )
  
  cellchat <- updateCellChat(cellchat)
  
  cellchat@DB <- CellChatDB.human
  
  cellchat <- subsetData(cellchat)
  
  # Identify overexpressed genes/interactions
  cellchat <- identifyOverExpressedGenes(
    cellchat,
    thresh.pc = 0.05,
    thresh.fc = 0.05
  )
  
  cellchat <- identifyOverExpressedInteractions(cellchat)
  
  # Compute communication probabilities
  cellchat <- computeCommunProb(
    cellchat,
    type = "truncatedMean",
    trim = 0.05
  )
  
  cellchat <- filterCommunication(
    cellchat,
    min.cells = 10
  )
  
  # Pathways and network
  cellchat <- computeCommunProbPathway(cellchat)
  cellchat <- aggregateNet(cellchat)
  
  # Save in list
  cellchat_list[[patient_id]] <- cellchat
}


df_list <- list()

for (patient_id in names(cellchat_list)) {
  
  message("Extracting: ", patient_id)
  
  df_tmp <- subsetCommunication(
    cellchat_list[[patient_id]],
    thresh = 1
  )
  
  df_tmp$patient_id <- patient_id
  
  df_list[[patient_id]] <- df_tmp
}

