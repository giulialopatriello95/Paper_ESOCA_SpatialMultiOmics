# ============================================================
# 1. Load packages and input data
# ============================================================

library(reshape2)

# Read sample metadata
df <- read.table("CD68area_metadata.txt")

# Read corrected CPM matrix
# Rows = genes
# Columns = samples / DCCs
gene_sample_matrix <- read.csv2(
  "MACRO_CPM_CORRECTED.csv",
  sep = ";",
  check.names = FALSE
)

# Convert to data.frame
gene_sample_matrix <- as.data.frame(gene_sample_matrix)

# Use the Gene column as row names
rownames(gene_sample_matrix) <- gene_sample_matrix$Gene

# Reorder/select the expression matrix columns
# according to the FastqID order in the metadata
gene_sample_matrix <- gene_sample_matrix[, df$FastqID]

# Convert metadata to data.frame
df <- as.data.frame(df)


# ============================================================
# 2. Prepare expression data
# ============================================================

# Initialize object containing the expression matrix
normalized_matrices <- list()

# Here normalized_matrices is actually a data.frame/matrix,
# despite the name suggesting it is a list of matrices
normalized_matrices <- gene_sample_matrix

# Empty list reserved for storing results
results_list <- list()


# ============================================================
# 3. Convert expression matrix from wide to long format
# ============================================================

# Convert the gene × sample matrix into a long-format table:
# one row = one gene/sample combination
data <- melt(as.matrix(normalized_matrices))

# Rename the columns
# Gene = gene name
# DCC  = sample identifier
# Value = CPM-corrected expression value
colnames(data) <- c("Gene", "DCC", "Value")


# ============================================================
# 4. Add sample metadata
# ============================================================

# Match each DCC/sample with its corresponding metadata
# using FastqID
data <- merge(
  data,
  df,
  by.x = "DCC",
  by.y = "FastqID"
)

# Remove A2M from the analysis
data <- data[data$Gene != "A2M", ]


# ============================================================
# 5. Calculate CR vs NR statistics for each gene
# ============================================================

# For every gene:
# - calculate the mean expression in NR
# - calculate the mean expression in CR
# - perform an unpaired t-test between NR and CR
result <- data %>%
  group_by(Gene) %>%
  summarise(
    
    # Mean expression in non-responders
    Mean_NR = mean(
      Value[Condition == "NR"],
      na.rm = TRUE
    ),
    
    # Mean expression in responders
    Mean_CR = mean(
      Value[Condition == "CR"],
      na.rm = TRUE
    ),
    
    # P-value from the t-test comparing NR vs CR
    P_Value = t.test(
      Value[Condition == "NR"],
      Value[Condition == "CR"]
    )$p.value
  )


# ============================================================
# 6. Identify significantly enriched genes
# ============================================================

# A gene is considered significant when P < 0.05.
#
# If significant:
#   CR = higher mean expression in CR
#   NR = higher mean expression in NR
#
# Otherwise:
#   No = not significant
#
# LFC is initially calculated as log2(CR / NR)
# but is recalculated below using the custom FoldChange.
final_results <- result %>%
  mutate(
    Significant = ifelse(
      P_Value < 0.05,
      ifelse(Mean_CR > Mean_NR, "CR", "NR"),
      "No"
    ),
    
    LFC = log(Mean_CR / Mean_NR, 2)
  )


# ============================================================
# 7. Calculate Fold Change
# ============================================================

# Calculate FoldChange while accounting for possible
# positive and negative expression values.
#
# Case 1:
#   CR >= 0 and NR >= 0
#   -> standard CR / NR
#
# Case 2:
#   CR >= 0 and NR < 0
#   -> shifted ratio using 1 + value
#
# Case 3:
#   CR < 0 and NR >= 0
#   -> shifted ratio using absolute CR value
#
# Case 4:
#   CR < 0 and NR < 0
#   -> return NA
final_results$FoldChange <- ifelse(
  
  # Both values are non-negative
  final_results$Mean_CR >= 0 &
    final_results$Mean_NR >= 0,
  
  final_results$Mean_CR / final_results$Mean_NR,
  
  ifelse(
    
    # CR positive, NR negative
    final_results$Mean_CR >= 0 &
      final_results$Mean_NR < 0,
    
    (1 + final_results$Mean_CR) /
      (1 + abs(final_results$Mean_NR)),
    
    ifelse(
      
      # CR negative, NR positive
      final_results$Mean_CR < 0 &
        final_results$Mean_NR >= 0,
      
      (1 + abs(final_results$Mean_CR)) /
        (1 + final_results$Mean_NR),
      
      # Both CR and NR are negative
      NA
    )
  )
)


# Convert FoldChange to log2 fold change
final_results$LFC <- log2(final_results$FoldChange)


