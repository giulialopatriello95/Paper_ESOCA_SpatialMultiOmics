# Use the Significant classification for plotting
# CR = significantly higher in CR
# NR = significantly higher in NR
# No = not significant
final_results$Enriched <- final_results$Significant


# ============================================================
# 11. Generate dot plot
# ============================================================

ggplot(
  final_results,
  aes(
    y = Gene,
    x = 1,
    color = Enriched
  )
) +
  
  # Dot size represents the absolute log2 fold change
  geom_point(
    aes(size = abs(LFC))
  ) +
  
  # Separate genes according to their manually assigned
  # biological category
  facet_wrap(
    ~GeneType,
    scales = "free_y",
    strip.position = "left"
  ) +
  
  # Minimal theme with Arial font
  theme_minimal(base_family = "Arial") +
  
  theme(
    axis.text.y = element_text(
      size = 12,
      family = "Arial",
      color = "black"
    ),
    axis.text.x = element_text(
      family = "Arial",
      color = "black"
    ),
    axis.title = element_text(
      family = "Arial",
      color = "black"
    ),
