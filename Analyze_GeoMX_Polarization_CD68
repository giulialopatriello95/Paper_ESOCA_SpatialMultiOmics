# Normalization function row gene and col sample
normalized_matrix <- function(data,df) {
  
  #Negative probes
  negative_probes <- data[grepl("Neg",rownames(data)),]
  geo_means <- apply(negative_probes, 2, function(x) exp(mean(log(x[x > 0]))))  
  negativeprobes_normalized_matrix <- sweep(data, 2, geo_means, "/")
  
  #Housekeeping
  housekeeping_probes <- data[rownames(data) %in% c("ACTB","GAPDH","RPLPO",
                                                    "B2M","HPRT1","TBP","PPIA",
                                                    "TUBB","SDHA","EIF4A1"),]
  housekeeping_geo_means <- apply(housekeeping_probes, 2, function(x) exp(mean(log(x[x > 0]))))  
  housekeeping_normalized_matrix <- sweep(data, 2, housekeeping_geo_means, "/")
  
  # CPM Normalization
  cpm_matrix <- cpm(data)
  cpm_matrix_negprobes<- sweep(cpm_matrix, 2, geo_means, "/")
  cpm_matrix_housekeeping<- sweep(cpm_matrix, 2, housekeeping_geo_means, "/")
  
  #LOG CPM Normalization
  log_cpm_matrix <- log2(cpm_matrix + 1)
  log_cpm_matrix_negprobes<- sweep(log_cpm_matrix, 2, geo_means, "/")
  log_cpm_matrix_housekeeping<- sweep(log_cpm_matrix, 2, housekeeping_geo_means, "/")
  
  #TMM Normalization 
  dge <- DGEList(counts = data)
  dge <- calcNormFactors(dge, method = "TMM")
  tmm_matrix <- cpm(dge)
  tmm_matrix_negprobes<- sweep(tmm_matrix, 2, geo_means, "/")
  tmm_matrix_housekeeping<- sweep(tmm_matrix, 2, housekeeping_geo_means, "/")  
  
  
  #QUANTILE
  quantile_matrix<-normalizeBetweenArrays(data, method = "quantile")
  quantile_matrix_negprobes<- sweep(quantile_matrix, 2, geo_means, "/")
  quantile_matrix_housekeeping<- sweep(quantile_matrix, 2, housekeeping_geo_means, "/")  
  
  #THIRD QUANTILE
  q3_values <- apply(data,2,quantile, probs = 0.75)
  q3_matrix <- sweep(data, 2, q3_values, "/")
  q3_matrix[!is.finite(q3_matrix)] <- 0
  q3_matrix_negprobes<- sweep(q3_matrix , 2, geo_means, "/")
  q3_matrix_housekeeping<- sweep(q3_matrix , 2, housekeeping_geo_means, "/")
  
  
  #AREA
  area_values <- df$Area
  area_matrix <- sweep(data, 2, area_values, "/")
  area_matrix[!is.finite(area_matrix)] <- 0
  area_matrix_negprobes<- sweep(area_matrix , 2, geo_means, "/")
  area_matrix_housekeeping<- sweep(area_matrix , 2, housekeeping_geo_means, "/")
  
  #NUCLEI
  nuclei_values <- as.integer(df$Nuclei)
  nuclei_matrix <- sweep(data, 2, nuclei_values, "/")
  nuclei_matrix[!is.finite(nuclei_matrix)] <- 0
  nuclei_matrix_negprobes<- sweep(nuclei_matrix , 2, geo_means, "/")
  nuclei_matrix_housekeeping<- sweep(nuclei_matrix , 2, housekeeping_geo_means, "/")
  
  
  #VST
  pseudocount <- median(data[data > 0]) / 10 
  vst_matrix <- log2(data + pseudocount)
  vst_matrix_negprobes<- sweep(vst_matrix , 2, geo_means, "/")
  vst_matrix_housekeeping<- sweep(vst_matrix , 2, housekeeping_geo_means, "/")
  
  #RLOG 
  pseudocount <- 1
  log_data <- log2(data + pseudocount)
  gene_means <- rowMeans(log_data)
  gene_sds <- apply(log_data, 1, sd)
  rlog_matrix<- t(apply(log_data, 1, function(x) (x - mean(x)) / sd(x) * mean(x)))
  rlog_matrix_negprobes<- sweep(rlog_matrix , 2, geo_means, "/")
  rlog_matrix_housekeeping<- sweep(rlog_matrix , 2, housekeeping_geo_means, "/")
  
  list(
    CPM = cpm_matrix,
    TMM = tmm_matrix,
    LogCPM = log_cpm_matrix,
    RLOG = rlog_matrix,
    VST = vst_matrix,
    Quantile = quantile_matrix,
    ThirdQuantile = q3_matrix,
    Area=area_matrix,
    Nuclei=nuclei_matrix,
    NegProbes=negativeprobes_normalized_matrix,
    Housekeeping=housekeeping_normalized_matrix,
    NegProbes_CPM = cpm_matrix_negprobes,
    Housekeeping_CPM = cpm_matrix_housekeeping,
    NegProbes_LogCPM = log_cpm_matrix_negprobes,
    Housekeeping_LogCPM = log_cpm_matrix_housekeeping,
    NegProbes_TMM = tmm_matrix_negprobes,
    Housekeeping_TMM = tmm_matrix_housekeeping,
    NegProbes_Quantile = quantile_matrix_negprobes,
    Housekeeping_Quantile = quantile_matrix_housekeeping,
    NegProbes_ThirdQuantile = q3_matrix_negprobes,
    Housekeeping_ThirdQuantile = q3_matrix_housekeeping,
    NegProbes_Area = area_matrix_negprobes,
    Housekeeping_Area = area_matrix_housekeeping,
    NegProbes_Nuclei = nuclei_matrix_negprobes,
    Housekeeping_Nuclei = nuclei_matrix_housekeeping,
    NegProbes_VST = vst_matrix_negprobes,
    Housekeeping_VST = vst_matrix_housekeeping,
    NegProbes_RLOG = rlog_matrix_negprobes,
    Housekeeping_RLOG = rlog_matrix_housekeeping
  )
}
