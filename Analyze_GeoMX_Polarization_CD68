library(reshape2)


results_list <- list()

#ERror with Third quartile
for (norm_name in names(normalized_matrices)) {
  # Get the normalized matrix
  print(norm_name)
  norm_matrix <- normalized_matrices[[norm_name]]
  data <- melt(norm_matrix)
  colnames(data) <- c("Gene", "DCC", "Value")
  data <- merge(data, df, by.x = "DCC", by.y = "FastqID")
  result <- data %>%
    group_by(Gene) %>%
    summarise(
      Mean_NR = mean(Value[Condition == "NR"], na.rm = TRUE),
      Mean_CR = mean(Value[Condition == "CR"], na.rm = TRUE),
      P_Value = t.test(Value[Condition == "NR"], Value[Condition == "CR"])$p.value
    ) %>%
    mutate(Normalization = norm_name)
  results_list[[norm_name]] <- result
}

#Negative probes
final_results <- bind_rows(results_list)
final_results<- final_results %>%
  mutate(Significant = ifelse(P_Value < 0.05, 
                              ifelse(Mean_CR > Mean_NR, "CR", "NR"),
                              "No"),LFC=log(Mean_CR/Mean_NR,2))


final_results$FoldChange <- ifelse(
  final_results$Mean_CR >= 0 & final_results$Mean_NR >= 0,
  final_results$Mean_CR / final_results$Mean_NR,
  
  ifelse(
    final_results$Mean_CR >= 0 & final_results$Mean_NR < 0,
    (1 + final_results$Mean_CR) / (1 + abs(final_results$Mean_NR)),
    
    ifelse(
      final_results$Mean_CR < 0 & final_results$Mean_NR >= 0,
      (1 + abs(final_results$Mean_CR)) / (1 + final_results$Mean_NR),
      
      NA  # fallback for both CR and NR < 0
    )
  )
)

final_results$LFC<-log(final_results$FoldChange,2)

DE_annotated <- final_results %>%
  mutate(
    hgnc_symbol = Gene,
    logFC = LFC,
    P.Value = ifelse(is.na(P_Value), 1, P_Value),
    sig = ifelse(P_Value < 0.05 & abs(LFC) > 0.58, "YES", "NO"),
    Module = case_when(
      LFC > 0.58 & P_Value < 0.05 ~ "CR",
      LFC < -0.58 & P_Value < 0.05 ~ "NR",
      TRUE ~ NA_character_
    )
  )

volcano_cols <- c(
  CR = "#D55E00",
  NR = "#0072B2"
)


ggplot(DE_annotated, aes(x = LFC, y = -log10(P.Value))) +
  
  geom_point(color = "grey70", alpha = 0.6) +
  
  geom_point(
    data = subset(DE_annotated, sig == "YES"),
    aes(color = Module),
    size = 2
  ) +
  
  geom_vline(xintercept = c(-0.58, 0.58), linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
  
  geom_text_repel(
    data = subset(DE_annotated, sig == "YES"),
    aes(label = hgnc_symbol, color = Module),
    size = 3,
    max.overlaps = 20,
    show.legend = FALSE
  ) +
  
  scale_color_manual(values = volcano_cols) +
  
  theme_minimal(base_family = "Arial") +
  theme(
    legend.position = "right",
    text = element_text(family = "Arial")
  ) +
  
  labs(
    x = expression(log[2]~Fold~Change),
    y = expression(-log[10]~adjusted~italic(P)),
    color = "",
    title = "Macrophage differential expression"
  )



