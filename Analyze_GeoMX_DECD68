gene_sample_matrix <- read_excel(
  "GeoMX_Raw_matrix.xlsx",sheet=1
)

df <- read_excel(
  "GeoMX_metadata.xlsx",sheet=1
)
gene_sample_matrix<-as.data.frame(gene_sample_matrix)
rownames(gene_sample_matrix)<-gene_sample_matrix$Gene

df<-df[df$markers=="CD68",]
df$N_samples_istologico <- sub(" .*", "", df$title)
gene_sample_matrix<-gene_sample_matrix[,df$library_name]




# Normalization function row gene and col sample
normalized_matrix <- function(data,df) {
  
  #Negative probes
  negative_probes <- data[grepl("Neg",rownames(data)),]
  geo_means <- apply(negative_probes, 2, function(x) exp(mean(log(x[x > 0]))))  
  negativeprobes_normalized_matrix <- sweep(data, 2, geo_means, "/")
  
  #Housekeeping
  housekeeping_probes <- data[rownames(data) %in% c("ACTB","GAPDH","RPLPO",
                                                    "B2M","HPRT1","TBP","PPIA",
                                                    "TUBB","SDHA","EIF4A1"),]
  housekeeping_geo_means <- apply(housekeeping_probes, 2, function(x) exp(mean(log(x[x > 0]))))  
  housekeeping_normalized_matrix <- sweep(data, 2, housekeeping_geo_means, "/")
  
  # CPM Normalization
  cpm_matrix <- cpm(data)
  cpm_matrix_negprobes<- sweep(cpm_matrix, 2, geo_means, "/")
  cpm_matrix_housekeeping<- sweep(cpm_matrix, 2, housekeeping_geo_means, "/")
  
  
  list(
    CPM = cpm_matrix,
    Raw=data
  )
}


normalized_matrices <- normalized_matrix(gene_sample_matrix,df)
library(edgeR)
metadata <- data.frame(
  sampleID  = df$library_name,
  condition = factor(df$response),
  batch     = factor(df$N_samples_istologico),
  cohort =factor(df$batch))
rownames(metadata) <- metadata$sampleID
library(metaRNASeq)
library(SurfR)
df.macro <- DGE(expression = normalized_matrices[["Raw"]],
                metadata = metadata,
                Nreplica = min(table(metadata$condition)),
                design = "~condition",
                condition = "condition",
                alpha = 0.05,
                TEST = "CR", CTRL =  "NR",
                output_tsv = FALSE)


df.macro <- DGE(expression = round(normalized_matrices[["CPM"]]),
                metadata = metadata,
                Nreplica = min(table(metadata$condition)),
                design = "~cohort + condition",
                condition = "condition",
                alpha = 0.05,
                TEST = "CR", CTRL =  "NR",
                output_tsv = FALSE)
df.macro<-as.data.frame(df.macro)



DE_annotated <- df.macro %>%
  tibble::rownames_to_column("gene") %>%
  mutate(
    hgnc_symbol = sapply(strsplit(gene, "_"), `[`, 1),
    logFC = log2FoldChange,
    P.Value = ifelse(is.na(padj), 1, padj),
    sig = ifelse(P.Value < 0.05 & abs(log2FoldChange) > 0.58, "YES", "NO"),
    Module = case_when(
      logFC > 0.58 & P.Value < 0.05 ~ "CR",
      logFC < -0.58 & P.Value < 0.05 ~ "NR",
      TRUE ~ NA_character_
    )
  )

volcano_cols <- c(
  "CR" = "#E64B35FF",
  "NR" = "#4DBBD5FF"
)

