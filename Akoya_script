# =========================================================
# FUNCTION: ReadAkoyaUpdate
# =========================================================

ReadAkoyaUpdate <- function(
  filename,
  type = c("inform", "processor", "qupath"),
  filter = "DAPI|Blank|Empty",
  inform.quant = c("mean", "total", "min", "max", "std")
) {

  if (!file.exists(filename)) {
    stop("Can't find file: ", filename)   # FIX: typo
  }

  type <- match.arg(tolower(type[1L]))

  ratio <- getOption("Seurat.input.sparse_ratio", default = 0.4)

  p <- progressr::progressor()
  p("Preloading Akoya matrix")

  sep <- switch(type, inform = "\t", ",")

  mtx <- data.table::fread(filename, sep = sep, data.table = FALSE)

  p(paste0("Parsing matrix in '", type, "' format"))

  outs <- switch(
    type,

    # =====================================================
    # PROCESSOR FORMAT
    # =====================================================
    processor = {

      centroids <- data.frame(
        x = mtx[["x:x"]],
        y = mtx[["y:y"]],
        cell = as.character(mtx[["cell_id:cell_id"]]),
        stringsAsFactors = FALSE
      )

      rownames(mtx) <- centroids$cell

      md <- mtx[, !grepl("^cyc", colnames(mtx)), drop = FALSE]
      colnames(md) <- vapply(strsplit(colnames(md), ":"), `[`, "", 2L)

      expr <- mtx[, grepl("^cyc", colnames(mtx)), drop = FALSE]
      colnames(expr) <- vapply(strsplit(colnames(expr), ":"), `[`, "", 2L)

      # FIX: safer filter check
      if (!is.null(filter) && !is.na(filter)) {
        expr <- expr[, !grepl(filter, colnames(expr)), drop = FALSE]
      }

      expr <- t(expr)

      if ((sum(expr == 0) / length(expr)) > ratio) {
        expr <- as.sparse(expr)
      }

      list(matrix = expr, centroids = centroids, metadata = md)
    },

    # =====================================================
    # INFORM FORMAT
    # =====================================================
    inform = {

      inform.quant <- match.arg(tolower(inform.quant[1L]))

      expr.key <- c(
        mean = "Mean",
        total = "Total",
        min = "Min",
        max = "Max",
        std = "Std Dev"
      )[inform.quant]

      expr.pattern <- "\\(Normalized Counts, Total Weighting\\)"

      rownames(mtx) <- mtx[["Cell ID"]]
      mtx <- mtx[, setdiff(colnames(mtx), "Cell ID"), drop = FALSE]

      centroids <- data.frame(
        x = mtx[["Cell X Position"]],
        y = mtx[["Cell Y Position"]],
        cell = rownames(mtx),
        stringsAsFactors = FALSE
      )

      cols <- setdiff(
        grep(expr.pattern, colnames(mtx), invert = TRUE, value = TRUE),
        paste("Cell", c("X", "Y"), "Position")
      )

      md <- mtx[, cols, drop = FALSE]

      expr.cols <- grep(paste(expr.key, expr.pattern), colnames(mtx), value = TRUE)

      expr <- mtx[, expr.cols, drop = FALSE]

      colnames(expr) <- gsub(paste(expr.key, expr.pattern), "", expr.cols)

      if (!is.null(filter) && !is.na(filter)) {
        expr <- expr[, !grepl(filter, colnames(expr)), drop = FALSE]
      }

      expr <- t(expr)

      if ((sum(expr == 0, na.rm = TRUE) / length(expr)) > ratio) {
        expr <- as.sparse(expr)
      }

      list(matrix = expr, centroids = centroids, metadata = md)
    },

    # =====================================================
    # QUPATH FORMAT
    # =====================================================
    qupath = {

      rownames(mtx) <- seq_len(nrow(mtx))

      xpos <- grep("Centroid X", colnames(mtx), value = TRUE)[1]
      ypos <- grep("Centroid Y", colnames(mtx), value = TRUE)[1]

      centroids <- data.frame(
        x = mtx[[xpos]],
        y = mtx[[ypos]],
        cell = rownames(mtx),
        stringsAsFactors = FALSE
      )

      cols <- setdiff(
        grep("Cell:.*mean", colnames(mtx), invert = TRUE, value = TRUE),
        c(xpos, ypos)
      )

      md <- mtx[, cols, drop = FALSE]

      idx <- grep("Cell:.*mean", colnames(mtx))

      expr <- mtx[, idx, drop = FALSE]
      colnames(expr) <- gsub(":| |/", ".", colnames(expr))

      if (!is.null(filter) && !is.na(filter)) {
        expr <- expr[, !grepl(filter, colnames(expr)), drop = FALSE]
      }

      expr <- t(expr)

      if ((sum(expr == 0) / length(expr)) > ratio) {
        expr <- as.sparse(expr)
      }

      list(matrix = expr, centroids = centroids, metadata = md)
    }
  )

  return(outs)
}

# =========================================================
# FUNCTION: LoadAkoyaUpdate
# =========================================================

LoadAkoyaUpdate <- function(filename, type = "qupath", fov, assay = "RNA") {

  data <- ReadAkoyaUpdate(filename, type)

  coords <- CreateFOV(
    coords = data$centroids,
    type = "centroids",
    key = "fov",
    assay = assay
  )

  colnames(data$metadata) <- make.names(colnames(data$metadata))

  obj <- CreateSeuratObject(
    counts = data$matrix,
    assay = assay,
    meta.data = data$metadata
  )

  coords <- subset(coords, cells = Cells(obj))
  obj[[fov]] <- coords

  return(obj)
}

# =========================================================
# LOAD FILES
# =========================================================

file_list <- c(
  "1LB.csv","3LB.csv","6LB.csv","7LB.csv","9LB.csv","11LB.csv",
  "13LB.csv","15LB.csv","17LB.csv","19LB.csv","21LB.csv",
  "23LB.csv","25LB.csv","27LB.csv",
  "00075293.csv","00075292.csv","00075298.csv","7599_part2.csv"
)

seurat_list <- list()

for (file in file_list) {

  if (!file.exists(file)) stop("Missing file: ", file)

  sample_name <- tools::file_path_sans_ext(basename(file))

  obj <- LoadAkoyaUpdate(
    filename = file,
    type = "qupath",
    fov = sample_name,
    assay = "RNA"
  )

  obj$sample <- sample_name

  obj <- RenameCells(obj, add.cell.id = sample_name)

  seurat_list[[sample_name]] <- obj
}

# =========================================================
# MERGE (FAST)
# =========================================================

merged_seurat <- merge(
  x = seurat_list[[1]],
  y = seurat_list[-1],
  project = "Merged"
)

# SAVE OBJECT (reproducible)
saveRDS(merged_seurat, "merged_seurat_raw.rds")

# =========================================================
# NORMALIZATION & FEATURES
# =========================================================

DefaultAssay(merged_seurat) <- "RNA"

merged_seurat <- NormalizeData(
  merged_seurat,
  normalization.method = "CLR",
  margin = 2
)

merged_seurat <- ScaleData(merged_seurat)

merged_seurat <- FindVariableFeatures(merged_seurat)

print(format(object.size(merged_seurat), units = "Mb"))

# =========================================================
# SKETCHING
# =========================================================

merged_seurat <- SketchData(
  merged_seurat,
  ncells = 5000,
  method = "LeverageScore",
  sketched.assay = "sketch",
  verbose = TRUE
)

merged_seurat[["sketch"]] <- FindVariableFeatures(merged_seurat[["sketch"]])

# =========================================================
# LOAD PRECOMPUTED PCA
# =========================================================

load("PCA.Rdata")   # NOTE: must contain integrated.rpca

# =========================================================
# CLUSTERING
# =========================================================

merged_seurat <- FindNeighbors(
  merged_seurat,
  reduction = "integrated.rpca",
  dims = 1:3
)

merged_seurat <- FindClusters(
  merged_seurat,
  resolution = 0.2
)

merged_seurat <- RunUMAP(
  merged_seurat,
  reduction = "integrated.rpca",
  dims = 1:3,
  return.model = TRUE
)

merged_seurat$cell_type <- Idents(merged_seurat)

# =========================================================
# PROJECT INTEGRATION TO FULL DATA
# =========================================================

features_to_use <- VariableFeatures(merged_seurat[["sketch"]])

merged_seurat <- ProjectIntegration(
  object = merged_seurat,
  sketched.assay = "sketch",
  assay = "RNA",
  reduction = "integrated.rpca",
  features = features_to_use
)

merged_seurat <- ProjectData(
  merged_seurat,
  sketched.assay = "sketch",
  assay = "RNA",
  sketched.reduction = "integrated.rpca.full",
  full.reduction = "integrated.rpca.full",
  dims = 1:3,
  refdata = list(celltype.full = "cell_type")
)

# =========================================================
# FULL UMAP
# =========================================================

plan(multicore, workers = 10)

merged_seurat <- RunUMAP(
  merged_seurat,
  reduction = "integrated.rpca.full",
  dims = 1:3,
  reduction.name = "umap.full",
  reduction.key = "UMAP_full_"
)

# SAVE FINAL
saveRDS(merged_seurat, "merged_seurat_complete.rds")

# =========================================================
# MARKER PLOT
# =========================================================

markers <- c(
  "Cell..CD.3.mean",
  "Cell..CD.20.mean",
  "Cell..IgM.mean",
  "Cell..AF.mean",
  "Cell..CD.11c.mean",
  "Cell..IgG.mean",
  "Cell..CK.8-18.mean"
)

DotPlot(merged_seurat, features = markers, cols = c("blue","red")) +
  RotatedAxis()
