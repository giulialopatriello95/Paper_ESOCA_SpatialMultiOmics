gene_sample_matrix <- read_excel(
  "GeoMX_Raw_matrix.xlsx",sheet=1
)

df <- read_excel(
  "GeoMX_metadata.xlsx",sheet=1
)


gene_sample_matrix<-gene_sample_matrix[,df$library_name]


df$merge <- ""

df$merge[df$markers %in% c("CD45", "CD68")] <- paste("STROMA", df$title[df$markers %in% c("CD45", "CD68")], sep = "_")

df$merge[df$markers == "PanCK"] <- paste("TUMOR", df$title[df$markers == "PanCK"], sep = "_")

group_vector<-df$merge
counts_t <- as.data.frame(t(gene_sample_matrix))
counts_t$Group <- group_vector

# Aggregate by group
merged_counts <- aggregate(. ~ Group, data = counts_t, FUN = sum)

# Transpose back to original format
merged_counts <- as.data.frame(t(merged_counts[-1]))
colnames(merged_counts) <- merged_counts[1,]
merged_counts <- merged_counts[-1,]
print(merged_counts)

dim(merged_counts)
colnames(merged_counts)<-unique(df$merge)
gene_sample_matrix<-merged_counts


cols_to_remove <- c("library_name", "title","markers")

df <- df %>%
  select(-all_of(cols_to_remove))
df$Segment_Name<-""
df$Segment_Name[grepl("STROMA",df$merge)]<-"STROMA"
df$Segment_Name[grepl("TUMORE",df$merge)]<-"TUMORE"
