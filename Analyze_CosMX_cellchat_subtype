# ---------------------------------------------------------
# CellChat analysis for each patient
# ---------------------------------------------------------

# Patients to analyze
patients <- unique(nano.obj.merge$patient)
patients <- patients[!is.na(patients)]


# Parallelization
future::plan("multisession", workers = 4)

# CellChat database
CellChatDB <- CellChatDB.human

# Create list to store results
cellchat_list <- list()

# ---------------------------------------------------------
# Loop over patients
# ---------------------------------------------------------

for (patient_id in patients) {
  
  message("======================================")
  message("Processing patient: ", patient_id)
  message("======================================")
  
  # Select patient
  seurat_object <- subset_opt(
    nano.obj.merge,
    patient == patient_id
  )
  
  # Check that patient has cells
  if (ncol(seurat_object) == 0) {
    warning("No cells found for patient: ", patient_id)
    next
  }
  
  # Create CellChat object
  cellchat <- createCellChat(
    object = seurat_object,
    meta = seurat_object@meta.data,
    group.by = "manualannot",
    datatype = "RNA"
  )
  
  # Make annotation factor and remove unused levels
  cellchat@meta$manualannot <- as.factor(
    cellchat@meta$manualannot
  )
  
  cellchat@meta$manualannot <- droplevels(
    cellchat@meta$manualannot
  )
  
  # Update and set database
  cellchat <- setIdent(
    cellchat,
    ident.use = "manualannot"
  )
  
  cellchat <- updateCellChat(cellchat)
  
  cellchat@DB <- CellChatDB
  
  # Subset data based on CellChat database
  cellchat <- subsetData(cellchat)
  
  # Identify overexpressed genes
  cellchat <- identifyOverExpressedGenes(
    cellchat,
    thresh.pc = 0.05,
    thresh.fc = 0.05
  )
  
  # Identify overexpressed interactions
  cellchat <- identifyOverExpressedInteractions(cellchat)
  
  # Compute communication probabilities
  cellchat <- computeCommunProb(
    cellchat,
    type = "truncatedMean",
    trim = 0.05
  )
  
  # Filter interactions
  cellchat <- filterCommunication(
    cellchat,
    min.cells = 10
  )
  
  # Compute pathway probabilities
  cellchat <- computeCommunProbPathway(cellchat)
  
  # Aggregate network
  cellchat <- aggregateNet(cellchat)
  
  # Store result using patient ID as name
  cellchat_list[[patient_id]] <- cellchat
  
  message("Finished patient: ", patient_id)
}

# ---------------------------------------------------------
# Save results
# ---------------------------------------------------------

save(
  cellchat_list,
  file = "CELLTYPE_Subtype_cellchat_allniches.RData"
)

